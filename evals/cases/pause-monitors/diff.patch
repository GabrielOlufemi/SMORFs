+/// Monitors that haven't been paused; these are the ones the scheduler checks.
+pub fn list_active_monitors(conn: &Connection) -> rusqlite::Result<Vec<Monitor>> {
+    let mut stmt = conn.prepare(
+        "SELECT id, name, url, expected_status, created_at FROM monitors
+         WHERE id NOT IN (SELECT monitor_id FROM paused_monitors) ORDER BY id",
+    )?;
+    let rows = stmt.query_map([], |row| {
+        Ok(Monitor {
+            id: row.get(0)?,
+            name: row.get(1)?,
+            url: row.get(2)?,
+            expected_status: row.get(3)?,
+            created_at: row.get(4)?,
+        })
+    })?;
+    rows.collect()
+}
+
+pub fn pause_monitor(conn: &Connection, id: i64) -> rusqlite::Result<()> {
+    conn.execute(
+        "INSERT OR IGNORE INTO paused_monitors (monitor_id) VALUES (?1)",
+        params![id],
+    )?;
+    Ok(())
+}
+
+pub fn resume_monitor(conn: &Connection, id: i64) -> rusqlite::Result<()> {
+    conn.execute("DELETE FROM paused_monitors WHERE monitor_id = ?1", params![id])?;
+    Ok(())
+}
