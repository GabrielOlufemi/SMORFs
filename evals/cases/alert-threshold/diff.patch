+/// Number of failed checks at the start of `checks` (newest first) before the first success.
+fn consecutive_failures(checks: &[Check]) -> usize {
+    checks.iter().take_while(|c| !c.up).count()
+}
+
+/// Decides whether the newest check should raise an alert.
+///
+/// `recent` is newest first and starts with the check that was just stored. A monitor is
+/// only reported down after `threshold` failures in a row, so a single slow response
+/// doesn't page anyone, and a recovery is only reported if the outage was.
+pub fn evaluate(monitor: &Monitor, recent: &[Check], threshold: usize) -> Option<Alert> {
+    let current = recent.first()?;
+    let kind = if current.up {
+        if consecutive_failures(&recent[1..]) < threshold {
+            return None;
+        }
+        AlertKind::Recovered
+    } else {
+        if consecutive_failures(recent) < threshold {
+            return None;
+        }
+        AlertKind::Down
     };
