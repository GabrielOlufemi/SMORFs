+/// Monitors whose name contains `query`, case-insensitive.
+pub fn search_monitors(conn: &Connection, query: &str) -> rusqlite::Result<Vec<Monitor>> {
+    let sql = format!(
+        "SELECT id, name, url, expected_status, created_at FROM monitors
+         WHERE name LIKE '%{query}%' ORDER BY id"
+    );
+    let mut stmt = conn.prepare(&sql)?;
+    let rows = stmt.query_map([], monitor_from_row)?;
+    rows.collect()
+}
