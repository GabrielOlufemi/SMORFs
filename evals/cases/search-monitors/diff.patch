+#[derive(Deserialize)]
+struct ListQuery {
+    /// Optional filter on the monitor name.
+    q: Option<String>,
+}
+
+async fn list_monitors(
+    State(state): State<AppState>,
+    Query(query): Query<ListQuery>,
+) -> Result<Json<Vec<db::Monitor>>, ApiError> {
+    let conn = conn(&state);
+    let monitors = match query.q.as_deref().map(str::trim) {
+        Some(q) if !q.is_empty() => db::search_monitors(&conn, q)?,
+        _ => db::list_monitors(&conn)?,
+    };
+    Ok(Json(monitors))
 }
 
