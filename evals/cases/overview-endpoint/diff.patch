+#[derive(Serialize)]
+struct MonitorOverview {
+    #[serde(flatten)]
+    monitor: db::Monitor,
+    #[serde(flatten)]
+    stats: stats::Stats,
+}
+
+/// Every monitor with its last-24h stats, for the dashboard's front page.
+async fn overview(State(state): State<AppState>) -> Result<Json<Vec<MonitorOverview>>, ApiError> {
+    let conn = conn(&state);
+    let since = unix_now() - DAY_SECS;
+
+    let mut overview = Vec::new();
+    for monitor in db::list_monitors(&conn)? {
+        let checks: Vec<db::Check> = db::all_checks(&conn, monitor.id)?
+            .into_iter()
+            .filter(|check| check.checked_at >= since)
+            .collect();
+        overview.push(MonitorOverview {
+            monitor,
+            stats: stats::compute(&checks),
+        });
+    }
+    Ok(Json(overview))
+}
